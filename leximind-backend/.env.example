# LexiMind Secure — Environment Variables
# Copy to .env and fill in your values.

# Django
SECRET_KEY=your-super-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DB_NAME=leximind_db
DB_USER=leximind
DB_PASSWORD=leximind
DB_HOST=localhost
DB_PORT=5432

# Redis (for Celery task queue — install Redis or use: sudo apt install redis)
REDIS_URL=redis://localhost:6379/0

# CORS — add your Vite dev server origin
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT token lifetimes
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7

# AES-256 encryption key for document storage
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AES_ENCRYPTION_KEY=

# ── OpenRouter AI ──────────────────────────────────────────────────────────────
# Get a FREE API key at https://openrouter.ai/ (no credit card needed for free models)
# Free models: https://openrouter.ai/models?order=top-weekly&supported_parameters=free
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Free model options (all require no billing):
#   meta-llama/llama-3.1-8b-instruct:free    ← DEFAULT (fast, good quality)
#   google/gemma-3-27b-it:free               ← Larger, higher quality
#   qwen/qwen3-8b:free                       ← Fast alternative
#   mistralai/mistral-7b-instruct:free       ← Classic fallback
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# OpenRouter usage attribution (required by their ToS)
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=LexiMind Secure
